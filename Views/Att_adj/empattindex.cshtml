@model IEnumerable<HRworks.Models.AttCalendarPunch>

@{
    ViewBag.Title = "Attendance Calendar";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var dateFrom = ViewBag.DateFrom is DateTime df ? df : new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    var year = dateFrom.Year;
    var month = dateFrom.Month;
    var firstOfMonth = new DateTime(year, month, 1);
    var daysInMonth = DateTime.DaysInMonth(year, month);
    var startDayOfWeek = (int)firstOfMonth.DayOfWeek;
    var today = DateTime.Today;

    var grouped = Model
        .GroupBy(x => x.Date)
        .ToDictionary(g => g.Key, g => g.ToList());

    var totalActiveDays = grouped.Count;
}

<link rel="stylesheet" href="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css" />

<div class="att-page">
    <div class="att-hero">
        <div class="att-hero-left">
            <span class="att-hero-kicker">Attendance</span>
            <h2 class="att-hero-month">@firstOfMonth.ToString("MMMM yyyy")</h2>
        </div>
        <div class="att-hero-right">
            <div class="att-hero-stat">
                <span class="att-hero-stat-num">@totalActiveDays</span>
                <span class="att-hero-stat-label">active days</span>
            </div>
        </div>
    </div>

    <div class="att-filters-card">
        @using (Html.BeginForm("empattindex", "Att_adj", FormMethod.Get, new { @class = "att-filters-form" }))
        {
            <div class="att-filters-row">
                <div class="att-filter">
                    <input type="text"
                           name="empatdatefrom"
                           id="empatdatefrom"
                           class="form-control att-input"
                           placeholder="Pick any date in the month"
                           value="@dateFrom.ToString("MM/dd/yyyy")" />
                </div>

                <div class="att-actions">
                    <input type="submit" value="Search" class="btn att-btn att-btn-primary" />

                    <button type="button"
                            class="btn att-btn att-btn-ghost"
                            onclick="window.location.href='@Url.Action("empattindex", "Att_adj", new { empatdatefrom = DateTime.Today })'">
                        This Month
                    </button>

                    <button type="button"
                            class="btn att-btn att-btn-ghost"
                            onclick="window.location.href='@Url.Action("Index", "Att_adj")'">
                        Attendance Adjustments
                    </button>
                </div>
            </div>
        }
    </div>

    <div class="att-calendar-card">
        <div class="att-weekdays">
            <div>Sun</div><div>Mon</div><div>Tue</div><div>Wed</div><div>Thu</div><div>Fri</div><div class="att-weekend-label">Sat</div>
        </div>

        <div class="att-grid">
            @{ var dayCounter = 1; const int maxWeeks = 6; }

            @for (var week = 0; week < maxWeeks; week++)
            {
                for (var dow = 0; dow < 7; dow++)
                {
                    if ((week == 0 && dow < startDayOfWeek) || dayCounter > daysInMonth)
                    {
                        <div class="att-cell att-cell-empty"></div>
                    }
                    else
                    {
                        var currentDate = new DateTime(year, month, dayCounter);
                        var entries = grouped.ContainsKey(currentDate) ? grouped[currentDate] : null;
                        var hasEntries = entries != null && entries.Count > 0;
                        var isToday = currentDate == today;
                        var isWeekend = dow == 0 || dow == 6;

                        var cellClasses = "att-cell";
                        if (hasEntries) {cellClasses += " att-cell-has";}
                        if (isToday) {cellClasses += " att-cell-today";}
                        if (isWeekend) {cellClasses += " att-cell-weekend";}

                        <div class="@cellClasses">
                            <div class="att-day-head">
                                <span class="att-day-number @(isToday ? "att-day-today" : "")">@dayCounter</span>
                            </div>

                            @if (hasEntries)
                            {
                                var first = entries.First();
                                var last = entries.Count > 1 ? entries.Last() : null;

                                var toShow = new List<HRworks.Models.AttCalendarPunch> { first };
                                if (last != null && last.Time != first.Time) {toShow.Add(last);}

                                <div class="att-punch-list">
                                    @foreach (var p in toShow)
                                    {
                                        var dirClass = p.IsCheckIn ? "att-punch-in" : "att-punch-out";
                                        <div class="att-punch-row @dirClass">
                                            <span class="att-punch-dot"></span>
                                            <span class="att-time">@p.Time.ToString(@"hh\:mm")</span>

                                            @if (p.HasAdjustment)
                                            {
                                                <span class="att-adj att-adj-@p.AdjustmentStatus.ToString().ToLower()">
                                                    @p.AdjustmentLabel · @p.AdjustmentStatus
                                                </span>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        class="att-adjust-btn"
                                                        data-date="@p.Date.ToString("yyyy-MM-dd")"
                                                        data-time="@p.Time"
                                                        data-displaydate="@p.Date.ToString("dd MMM yyyy")"
                                                        data-displaytime="@p.Time.ToString(@"hh\:mm")">
                                                    Adjust
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        dayCounter++;
                    }
                }

                if (dayCounter > daysInMonth) { break; }
            }
        </div>
    </div>
</div>

<div id="attAdjustDialog" title="Attendance adjustment" style="display:none;">
    <div class="att-dialog-body">
        <div class="att-dialog-line">
            <span class="att-dialog-label">Date</span>
            <span class="att-dialog-value" id="dlgDate"></span>
        </div>
        <div class="att-dialog-line">
            <span class="att-dialog-label">Time</span>
            <span class="att-dialog-value" id="dlgTime"></span>
        </div>
        <div class="att-dialog-hint">Choose adjustment type for this punch:</div>
    </div>
</div>

<style>
    /* ===== Page ===== */
    .att-page {
        padding: 4px 0 28px 0;
        font-family: "Segoe UI", Tahoma, Arial, sans-serif;
        color: #0f172a;
    }

    /* ===== Hero ===== */
    .att-hero {
        position: relative;
        background: linear-gradient(135deg, #0f2436 0%, #143a5a 50%, #1b4e78 100%);
        color: #fff;
        border-radius: 12px;
        padding: 18px 22px;
        margin-bottom: 14px;
        box-shadow: 0 8px 24px rgba(15, 36, 54, 0.18);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        overflow: hidden;
    }

        .att-hero::before {
            content: "";
            position: absolute;
            right: -60px;
            top: -60px;
            width: 220px;
            height: 220px;
            border-radius: 50%;
            background: radial-gradient(circle at center, rgba(255,255,255,0.12), transparent 70%);
            pointer-events: none;
        }

    .att-hero-left {
        position: relative;
        z-index: 1;
    }

    .att-hero-kicker {
        display: block;
        opacity: 0.75;
        font-size: 11px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        margin-bottom: 2px;
    }

    .att-hero-month {
        margin: 0;
        font-weight: 600;
        font-size: 26px;
        letter-spacing: -0.01em;
    }

    .att-hero-right {
        position: relative;
        z-index: 1;
    }

    .att-hero-stat {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        padding: 8px 16px;
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: 10px;
        backdrop-filter: blur(6px);
    }

    .att-hero-stat-num {
        font-size: 22px;
        font-weight: 700;
        line-height: 1.1;
    }

    .att-hero-stat-label {
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        opacity: 0.8;
    }

    /* ===== Filters ===== */
    .att-filters-card {
        background: #fff;
        border: 1px solid #e6edf5;
        border-radius: 12px;
        padding: 12px 16px;
        margin-bottom: 14px;
        box-shadow: 0 2px 10px rgba(15, 23, 42, 0.04);
    }

    .att-filters-row {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .att-filter {
        min-width: 220px;
    }

    .att-input {
        border-radius: 8px;
        height: 36px;
        border: 1px solid #dbe5ef;
        box-shadow: none;
        font-size: 13px;
    }

        .att-input:focus {
            border-color: #1b4e78;
            box-shadow: 0 0 0 3px rgba(27, 78, 120, 0.12);
        }

    .att-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-left: auto;
    }

    .att-btn {
        border-radius: 8px;
        padding: 8px 14px;
        font-size: 12px;
        font-weight: 600;
        line-height: 1;
        transition: all 0.15s ease;
    }

    .att-btn-primary {
        background: #0f2436;
        border: 1px solid #0f2436;
        color: #fff;
    }

        .att-btn-primary:hover {
            background: #1b4e78;
            border-color: #1b4e78;
            color: #fff;
        }

    .att-btn-ghost {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        color: #0f172a;
    }

        .att-btn-ghost:hover {
            background: #eef5ff;
            border-color: #c9d7ea;
        }

    /* ===== Calendar Card ===== */
    .att-calendar-card {
        background: #fff;
        border: 1px solid #e6edf5;
        border-radius: 12px;
        padding: 14px;
        box-shadow: 0 2px 10px rgba(15, 23, 42, 0.04);
        overflow-x: auto;
    }

    /* Weekday strip */
    .att-weekdays {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 6px;
        margin-bottom: 6px;
        min-width: 720px;
    }

        .att-weekdays > div {
            text-align: center;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: #64748b;
            padding: 8px 0;
        }

            .att-weekdays .att-weekend-label,
            .att-weekdays > div:first-child {
                color: #94a3b8;
            }

    /* Grid */
    .att-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 6px;
        min-width: 720px;
    }

    .att-cell {
        position: relative;
        background: #fff;
        border: 1px solid #eef2f7;
        border-radius: 10px;
        min-height: 110px;
        padding: 8px 10px 10px 10px;
        transition: box-shadow 0.15s ease, transform 0.15s ease;
    }

    .att-cell-empty {
        background: #f8fafc;
        border-style: dashed;
        border-color: #eef2f7;
    }

    .att-cell-weekend {
        background: #fafbfd;
    }

    .att-cell-has {
        background: #fbfdff;
        border-color: #e3ecf7;
    }

        .att-cell-has:hover {
            box-shadow: 0 4px 14px rgba(15, 36, 54, 0.08);
            transform: translateY(-1px);
        }

    .att-cell-today {
        border: 1.5px solid #1b4e78;
        box-shadow: 0 0 0 3px rgba(27, 78, 120, 0.10);
    }

        .att-cell-today::before {
            content: "";
            position: absolute;
            top: 0;
            left: 14px;
            right: 14px;
            height: 3px;
            background: linear-gradient(90deg, #1b4e78, #3b82f6);
            border-radius: 0 0 3px 3px;
        }

    /* Day number */
    .att-day-head {
        display: flex;
        justify-content: flex-start;
        margin-bottom: 6px;
    }

    .att-day-number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 22px;
        height: 22px;
        padding: 0 7px;
        border-radius: 11px;
        color: #475569;
        font-size: 12px;
        font-weight: 700;
    }

    .att-day-today {
        background: #1b4e78;
        color: #fff;
        box-shadow: 0 2px 6px rgba(27, 78, 120, 0.35);
    }

    /* Punch rows */
    .att-punch-list {
        display: flex;
        flex-direction: column;
        gap: 6px;
        margin-top: 2px;
    }

    .att-punch-row {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 4px 6px;
        border-radius: 6px;
        background: #f8fbff;
        border: 1px solid #eef4fb;
    }

    .att-punch-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .att-punch-in .att-punch-dot {
        background: #10b981;
        box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.18);
    }

    .att-punch-out .att-punch-dot {
        background: #f59e0b;
        box-shadow: 0 0 0 2px rgba(245, 158, 11, 0.18);
    }

    .att-time {
        font-size: 12px;
        font-weight: 700;
        color: #0f172a;
        font-variant-numeric: tabular-nums;
        letter-spacing: 0.01em;
    }

    .att-adjust-btn {
        margin-left: auto;
        background: #fff;
        border: 1px solid #d5dde7;
        color: #1b4e78;
        font-size: 10.5px;
        font-weight: 600;
        padding: 3px 9px;
        border-radius: 5px;
        cursor: pointer;
        white-space: nowrap;
        transition: all 0.15s ease;
    }

        .att-adjust-btn:hover {
            background: #1b4e78;
            border-color: #1b4e78;
            color: #fff;
        }

    /* Adjustment pills */
    .att-adj {
        margin-left: auto;
        font-size: 10px;
        font-weight: 700;
        padding: 3px 7px;
        border-radius: 5px;
        white-space: nowrap;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .att-adj-approved {
        background: #dcfce7;
        color: #166534;
    }

    .att-adj-pending {
        background: #fef3c7;
        color: #92400e;
    }

    /* ===== Dialog ===== */
    .ui-dialog {
        border-radius: 12px !important;
        overflow: hidden;
        border: 1px solid #e6edf5 !important;
        box-shadow: 0 14px 36px rgba(15, 36, 54, 0.18) !important;
    }

    .ui-dialog-titlebar {
        background: linear-gradient(135deg, #0f2436, #1b4e78) !important;
        color: #fff !important;
        border: none !important;
        padding: 12px 14px !important;
    }

    .ui-dialog-title {
        font-size: 13px !important;
        font-weight: 600 !important;
    }

    .ui-dialog-content {
        padding: 16px 18px !important;
    }

    .ui-dialog-buttonpane {
        padding: 10px 12px !important;
        border-top: 1px solid #eef2f7 !important;
        background: #fafcff !important;
    }

    .ui-dialog-buttonset button {
        border-radius: 8px !important;
        font-size: 12px !important;
        font-weight: 600 !important;
        padding: 7px 14px !important;
        margin-left: 6px !important;
    }

    .att-dialog-body {
        font-size: 13px;
    }

    .att-dialog-line {
        display: flex;
        gap: 12px;
        margin-bottom: 8px;
    }

    .att-dialog-label {
        width: 50px;
        font-weight: 700;
        color: #64748b;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        padding-top: 2px;
    }

    .att-dialog-value {
        font-weight: 700;
        color: #0f172a;
    }

    .att-dialog-hint {
        margin-top: 12px;
        font-size: 12px;
        color: #64748b;
        font-style: italic;
    }

    /* ===== Responsive ===== */
    @@media (max-width: 992px) {
        .att-cell {
            min-height: 100px;
        }
    }

    @@media (max-width: 768px) {
        .att-hero {
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
            padding: 14px 16px;
        }

        .att-hero-stat {
            align-items: flex-start;
        }

        .att-hero-month {
            font-size: 22px;
        }

        .att-filters-card {
            padding: 10px 12px;
        }

        .att-actions {
            margin-left: 0;
        }

        .att-calendar-card {
            padding: 10px;
        }
    }

    @@media (max-width: 560px) {
        .att-punch-row {
            flex-wrap: wrap;
        }

        .att-adjust-btn, .att-adj {
            margin-left: 24px;
        }
    }
</style>

@section Scripts {
    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.min.js"></script>
    <script>
        $(function () {
            $("#empatdatefrom").datepicker({
                changeMonth: true,
                changeYear: true,
                dateFormat: "mm/dd/yy"
            });

            var baseCreateUrl = '@Url.Action("create", "Att_adj")';

            function openAdjustDialog(dateVal, timeVal, displayDate, displayTime) {
                $("#dlgDate").text(displayDate || dateVal);
                $("#dlgTime").text(displayTime || timeVal);

                var lateUrl  = baseCreateUrl + "?atjdate=" + encodeURIComponent(dateVal) + "&atjtime=" + encodeURIComponent(timeVal) + "&inout=true";
                var earlyUrl = baseCreateUrl + "?atjdate=" + encodeURIComponent(dateVal) + "&atjtime=" + encodeURIComponent(timeVal) + "&inout=false";

                $("#attAdjustDialog").dialog({
                    modal: true,
                    width: 380,
                    resizable: false,
                    buttons: [
                        { text: "Late In",   click: function () { window.location.href = lateUrl; } },
                        { text: "Early Out", click: function () { window.location.href = earlyUrl; } },
                        { text: "Cancel",    click: function () { $(this).dialog("close"); } }
                    ]
                });
            }

            $(document).on("click", ".att-adjust-btn", function () {
                var $btn = $(this);
                openAdjustDialog($btn.data("date"), $btn.data("time"), $btn.data("displaydate"), $btn.data("displaytime"));
            });
        });
    </script>
}